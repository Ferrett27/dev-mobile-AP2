<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/context/tools"
    android:id="@+id/main_resultado"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zzz_fundo_escuro"
    tools:context=".activities.ResultadoActivity">

    <TextView
        android:id="@+id/tv_titulo_resultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="AVALIAÇÃO PROXY"
        android:textColor="@color/zzz_texto_secundario"
        android:textSize="18sp"
        android:letterSpacing="0.2"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@+id/btn_compartilhar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_titulo_resultado">

        <TextView
            android:id="@+id/tv_resultado_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            tools:text="RANK S"
            tools:textColor="#FFD700" />

        <TextView
            android:id="@+id/tv_resultado_personagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/zzz_destaque_branco"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Agente: Starlight Billy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SYNC RATE"
            android:textColor="@color/zzz_texto_secundario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_score_resultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="84sp"
            android:textStyle="bold"
            tools:text="92%"
            tools:textColor="#FFD700" />

        <TextView
            android:id="@+id/tv_resultado_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="24dp"
            android:textAlignment="center"
            android:textColor="@color/zzz_destaque_branco"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            tools:text="Build Perfeita! Sincronização máxima atingida." />

    </LinearLayout>

    <Button
        android:id="@+id/btn_compartilhar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/white"
        android:text="Compartilhar Resultado"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_voltar_inicio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_voltar_inicio"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/zzz_superficie"
        android:text="Voltar ao Início"
        android:textColor="@color/zzz_destaque_branco"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>